# Matches the POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB in docker-compose.yml
# for local dev. This password is fine for a local-only Postgres container
# but must be replaced with your own strong, unique password for any
# production deployment (see docker-compose.prod.yml, which requires you to
# supply POSTGRES_PASSWORD yourself instead of shipping a default).
DATABASE_URL=postgresql://scanhive:scanhive_dev_password@postgres:5432/scanhive

# Browser application URL, used to build links sent in invitation emails.
FRONTEND_URL=http://localhost

# Optional: comma-separated list of extra origins allowed to call the API,
# e.g. a public domain or IP the dashboard is served from
# (https://scanhive.example.com,http://203.0.113.10). localhost, 127.0.0.1
# and private LAN ranges (10.x, 192.168.x, 172.16-31.x) are already allowed
# and don't need to be listed here.
EXTRA_CORS_ORIGINS=

# Optional: SMTP delivery for invitation emails. Leave SMTP_HOST blank to
# disable email sending -- invitations still work, and the invite link can
# be copied and shared manually from Settings -> Users.
#
# For local testing without a real mail provider, run
# `docker compose --profile mail-testing up -d` and use:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_USE_TLS=false
# then read caught mail at http://localhost:8025 (no login).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ScanHive
SMTP_USE_TLS=true

# --- Email (required for account verification, password reset, invitations) ---
# Use any SMTP provider (your hosting provider's mailbox, Mailgun, SES, Postmark, ...).
# Example values -- replace with your provider's:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=465                        # 465 = implicit TLS; 587 = STARTTLS (SMTP_USE_TLS=true)
#   SMTP_USE_TLS=true
#   SMTP_USERNAME=noreply@example.com    # usually the full mailbox address
#   SMTP_PASSWORD=<mailbox or API password>   # keep this only on the server
#   SMTP_FROM_EMAIL=noreply@example.com  # most providers require this to match the login
#   SMTP_FROM_NAME=ScanHive
#   FRONTEND_URL=https://scanhive.example.com   # links in emails point here
# Then verify: docker compose exec backend python -m app.scripts.send_test_email you@example.com

# Password reset (Forgot password). Links are emailed via the SMTP settings
# below and stay valid for PASSWORD_RESET_TOKEN_EXPIRE_MINUTES, single use.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3

# Trust X-Real-IP from the bundled nginx for per-IP rate limiting. Only leave
# this on when the API is reachable exclusively through that proxy (as in
# docker-compose.prod.yml); otherwise clients can spoof their IP.
TRUST_PROXY_HEADERS=true

# Without SMTP the reset email can't be sent. Setting this to true writes the
# reset link to the backend log instead -- convenient for a private
# self-hosted install, but anyone who can read the logs could take over any
# account, so leave it false unless you accept that.
PASSWORD_RESET_LOG_LINK=false

# Email verification for new accounts (sign-up requires a confirmed address).
# Without working SMTP, set EMAIL_VERIFICATION_LOG_LINK=true to write the link
# to the backend log (trusted-log installs only), or EMAIL_VERIFICATION_REQUIRED=false
# to skip verification entirely.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_MAX_PER_HOUR=3
EMAIL_VERIFICATION_LOG_LINK=false
